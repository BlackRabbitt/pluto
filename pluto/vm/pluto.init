#!/sbin/openrc-run
# shellcheck disable=SC2034

description="Pluto service"
supervisor=supervise-daemon
command=/usr/local/bin/pluto
command_args="--vm-service /var/lib/pluto /run/pluto/api.sock"
command_user=pluto-api:pluto-api
directory=/var/lib/pluto
umask=0077
respawn_delay=1
respawn_max=5
respawn_period=60
error_log=/var/lib/pluto/service.log

depend() {
    need net
}

start_pre() {
    checkpath -d -m 0700 -o pluto-api:pluto-api /run/pluto
}
